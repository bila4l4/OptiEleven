{
    "id":  "perf-netthrottle",
    "kind":  "tweak",
    "category":  "Rendimiento",
    "order":  170,
    "name":  {
                 "es":  "Red sin límite multimedia",
                 "en":  "No multimedia network cap"
             },
    "summary":  {
                    "es":  "Windows no frena la red mientras suena audio o vídeo.",
                    "en":  "Windows stops capping the network while audio or video plays."
                },
    "risk":  "moderate",
    "presets":  [
                    "advanced"
                ],
    "requiresAdmin":  true,
    "reboot":  false,
    "reversible":  true,
    "undo":  {
                 "type":  "snapshot"
             },
    "actions":  [
                    {
                        "registry":  "HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile",
                        "name":  "NetworkThrottlingIndex",
                        "type":  "DWord",
                        "value":  "-1",
                        "default":  null
                    }
                ],
    "details":  {
                    "es":  "Quita el límite que Windows pone a la red mientras suena audio o vídeo. Útil si juegas online con Discord o música abiertos.",
                    "en":  "Removes the limit Windows puts on the network while audio or video plays. Useful if you play online with Discord or music open."
                }
}
