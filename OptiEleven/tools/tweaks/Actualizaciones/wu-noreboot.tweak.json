{
    "id":  "wu-noreboot",
    "kind":  "tweak",
    "category":  "Actualizaciones",
    "order":  280,
    "name":  {
                 "es":  "Sin reinicios automáticos",
                 "en":  "No automatic restarts"
             },
    "summary":  {
                    "es":  "Windows Update avisa y reinicias tú.",
                    "en":  "Windows Update asks and you restart."
                },
    "risk":  "safe",
    "presets":  [
                    "recommended",
                    "advanced"
                ],
    "requiresAdmin":  true,
    "reboot":  false,
    "reversible":  true,
    "undo":  {
                 "type":  "snapshot"
             },
    "actions":  [
                    {
                        "registry":  "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU",
                        "name":  "NoAutoRebootWithLoggedOnUsers",
                        "type":  "DWord",
                        "value":  1,
                        "default":  null
                    }
                ],
    "details":  {
                    "es":  "Windows Update no reinicia el equipo mientras estás conectado; te avisa y reinicias tú.",
                    "en":  "Windows Update won\u0027t restart the PC while you\u0027re signed in; it tells you and you restart."
                }
}
