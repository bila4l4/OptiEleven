                        "name":  "DODownloadMode",
                        "type":  "DWord",
                        "value":  0,
                        "default":  null
                    }
                ],
    "details":  {
                    "es":  "Desactiva la Optimización de distribución (P2P): tu conexión no sube actualizaciones a otros PCs mientras juegas online.",
                    "en":  "Turns off Delivery Optimization (P2P): your connection doesn\u0027t upload updates to other PCs while you play online."
                }
