{
    "id":  "svc-diag",
    "kind":  "tweak",
    "category":  "Privacidad",
    "order":  510,
    "name":  {
                 "es":  "Sin diagnósticos de Windows",
                 "en":  "Windows diagnostics off"
             },
    "summary":  {
                    "es":  "Los solucionadores de problemas dejan de funcionar.",
                    "en":  "Troubleshooters stop working."
                },
    "risk":  "advanced",
    "presets":  [
                    "advanced"
                ],
    "requiresAdmin":  true,
    "reboot":  false,
    "reversible":  true,
    "undo":  {
                 "type":  "snapshot"
             },
    "actions":  [
                    {
                        "service":  "DPS",
                        "startup":  "Disabled",
                        "default":  "Auto"
                    },
                    {
                        "service":  "WdiServiceHost",
                        "startup":  "Disabled",
                        "default":  "Manual"
                    },
                    {
                        "service":  "WdiSystemHost",
                        "startup":  "Disabled",
                        "default":  "Manual"
                    },
                    {
                        "service":  "TroubleshootingSvc",
                        "startup":  "Disabled",
                        "default":  "Manual"
                    }
                ],
    "details":  {
                    "es":  "Desactiva el servicio de directivas de diagnóstico y sus anfitriones. Dejan de funcionar los solucionadores de problemas y el uso de red por app del Administrador de tareas.",
                    "en":  "Turns off the Diagnostic Policy Service and its hosts. Troubleshooters and per-app network usage in Task Manager stop working."
                }
}
